<UserControl x:Class="ArcGISClaude.ChatDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="360">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary
                    Source="pack://application:,,,/ArcGIS.Desktop.Framework;component/Themes/Default.xaml" />
                <ResourceDictionary Source="/ArcGISClaude;component/UI/ChatItemTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- Status bar -->
        <Border DockPanel.Dock="Top" Padding="6"
                Background="{DynamicResource Esri_BackgroundPressedBrush}">
            <DockPanel>
                <CheckBox DockPanel.Dock="Right" Content="Show tool details"
                          IsChecked="{Binding ShowToolOutputs}"
                          VerticalAlignment="Center" Margin="8,0,0,0"
                          ToolTip="Show the tool calls Claude makes (generated code and results)." />
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                           Opacity="0.85" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Input row -->
        <Border DockPanel.Dock="Bottom" Padding="6"
                Background="{DynamicResource Esri_BackgroundPressedBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="48" MaxHeight="140"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="Describe what you want to do to the open project, then press Enter.">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1" Content="Send" MinWidth="64" Margin="6,0,0,0"
                        Style="{DynamicResource Esri_Button}"
                        Command="{Binding SendCommand}" />
            </Grid>
        </Border>

        <!-- Transcript -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2">
            <ItemsControl ItemsSource="{Binding Items}" Margin="4" />
        </ScrollViewer>

    </DockPanel>
</UserControl>
