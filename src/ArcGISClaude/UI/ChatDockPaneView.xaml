<UserControl x:Class="ArcGISClaude.ChatDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:ui="clr-namespace:ArcGISClaude.UI"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="360">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary
                    Source="pack://application:,,,/ArcGIS.Desktop.Framework;component/Themes/Default.xaml" />
                <ResourceDictionary Source="/ArcGISClaude;component/UI/ChatItemTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- Status bar -->
        <Border DockPanel.Dock="Top" Padding="6"
                Background="{DynamicResource Esri_BackgroundPressedBrush}">
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Opacity="0.85" />
        </Border>

        <!-- Work-in-progress indicator: a thin strip that pulses while a turn is
             active. Opacity animation (not color) — the Esri theme brushes are
             shared DynamicResource objects whose colors can't be animated, and an
             opacity pulse follows both dark and light themes for free. -->
        <Border DockPanel.Dock="Top" Height="3"
                Background="{DynamicResource Esri_BackgroundSelectedBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTurnActive}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="Pulse">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.2" To="1.0" Duration="0:0:1.2"
                                                         AutoReverse="True"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulse" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Input row -->
        <Border DockPanel.Dock="Bottom" Padding="6"
                Background="{DynamicResource Esri_BackgroundPressedBrush}">
            <StackPanel>
                <CheckBox Content="Show tool details" Margin="2,0,0,6"
                          IsChecked="{Binding ShowToolOutputs}"
                          ToolTip="Show the tool calls Claude makes (generated code and results)." />
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="48" MaxHeight="140"
                         VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="OnInputPreviewKeyDown"
                         ToolTip="Describe what you want to do to the open project, then press Enter (Shift+Enter for a new line)." />

                <Button Grid.Column="1" Content="Send" MinWidth="64" Margin="6,0,0,0"
                        Style="{DynamicResource Esri_Button}"
                        Command="{Binding SendCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Transcript (auto-scrolls to the newest message) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="2" ui:AutoScroll.ToEnd="True">
            <ItemsControl ItemsSource="{Binding Items}" Margin="4" />
        </ScrollViewer>

    </DockPanel>
</UserControl>
