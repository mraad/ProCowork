<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:ArcGISClaude.UI">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- User message -->
    <DataTemplate DataType="{x:Type ui:UserMessageVm}">
        <Border Margin="40,4,4,4" Padding="8" CornerRadius="6"
                Background="{DynamicResource Esri_BackgroundSelectedBrush}"
                HorizontalAlignment="Right">
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
        </Border>
    </DataTemplate>

    <!-- Assistant message (rendered as markdown; inherits the themed foreground) -->
    <DataTemplate DataType="{x:Type ui:AssistantMessageVm}">
        <Border Margin="4,4,40,4" Padding="8" CornerRadius="6"
                Background="{DynamicResource Esri_BackgroundPressedBrush}"
                HorizontalAlignment="Left">
            <ui:MarkdownPresenter Markdown="{Binding Text}" />
        </Border>
    </DataTemplate>

    <!-- Tool call: shows the generated code that ran + its result -->
    <DataTemplate DataType="{x:Type ui:ToolCallVm}">
        <Border Margin="4,4,20,4" Padding="6" CornerRadius="4"
                BorderThickness="1"
                BorderBrush="{DynamicResource Esri_BorderBrush}"
                Background="{DynamicResource Esri_BackgroundBrush}">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="&#9656;" Margin="0,0,4,0" FontWeight="Bold" />
                    <TextBlock Text="{Binding ToolName}" FontWeight="Bold" />
                    <TextBlock Text="{Binding Status}" Margin="8,0,0,0" Opacity="0.7"
                               DockPanel.Dock="Right" HorizontalAlignment="Right" />
                </DockPanel>

                <TextBox Text="{Binding Code, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="11"
                         Margin="14,4,0,0" Padding="4"
                         BorderThickness="0"
                         Background="{DynamicResource Esri_BackgroundPressedBrush}"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         MaxHeight="220"
                         Visibility="{Binding HasCode, Converter={StaticResource BoolToVis}}" />

                <Border Margin="14,4,0,0" Padding="4"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Esri_BackgroundPressedBrush}">
                    <TextBlock Text="{Binding Result}" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="11" Opacity="0.9" />
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- System / error notice -->
    <DataTemplate DataType="{x:Type ui:SystemNoticeVm}">
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontStyle="Italic"
                   Margin="6,2,6,2" Opacity="0.8" />
    </DataTemplate>

</ResourceDictionary>
