<UserControl x:Class="ArcGISClaude.AuthOptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="520">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary
                    Source="pack://application:,,,/ArcGIS.Desktop.Framework;component/Themes/Default.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="12">
        <TextBlock Text="Claude authentication" FontWeight="Bold" FontSize="14" />
        <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,2,0,10"
                   Text="How the embedded Claude engine signs in. The default uses your Claude Code subscription login — no API key required." />

        <TextBlock Text="Sign-in method" />
        <ComboBox SelectedIndex="{Binding AuthModeIndex}" Margin="0,2,0,8">
            <ComboBoxItem Content="Claude subscription (Pro/Max login) — recommended" />
            <ComboBoxItem Content="Claude subscription via OAuth token (claude setup-token)" />
            <ComboBoxItem Content="Anthropic API key (per-token billing)" />
        </ComboBox>

        <TextBlock Text="Token / API key (stored encrypted with Windows DPAPI)" />
        <PasswordBox x:Name="SecretBox" PasswordChanged="SecretBox_PasswordChanged" Margin="0,2,0,2" />
        <TextBlock Text="Leave blank for the subscription login option." Opacity="0.7" Margin="0,0,0,8" />

        <TextBlock Text="Model" />
        <ComboBox IsEditable="True"
                  ItemsSource="{Binding KnownModels}"
                  Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                  Margin="0,2,0,2" />
        <TextBlock Text="Pick a known model id, or leave blank to use Claude Code's default." Opacity="0.7" Margin="0,0,0,8" />

        <TextBlock Text="Path to 'claude' (optional override)" />
        <TextBox Text="{Binding ClaudePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

        <Button Content="Check" Command="{Binding CheckCommand}"
                HorizontalAlignment="Left" MinWidth="80" />
        <TextBlock Text="{Binding CheckResult}" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
</UserControl>
