<?xml version="1.0" encoding="utf-8"?>
<ArcGIS defaultAssembly="ArcGISClaude.dll"
        defaultNamespace="ArcGISClaude"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry Registry.xsd">

  <AddInInfo id="{8E5C8B9A-2F4D-4C9E-9A1B-7C2E0D6F1A02}" version="0.1.11" desktopVersion="3.6">
    <Name>ProCowork in ArcGIS Pro</Name>
    <Description>A native chat panel that lets the Claude Code engine drive ArcGIS Pro through Python, ArcPy, and the live map.</Description>
    <Image>Images\AddinDesktop32.png</Image>
    <Author>mraad23</Author>
    <Company>mraad23</Company>
    <Date>2026-06-14</Date>
    <Subject>Framework</Subject>
  </AddInInfo>

  <modules>
    <insertModule id="ArcGISClaude_Module"
                  className="Module1"
                  autoLoad="true"
                  caption="ProCowork Module">

      <tabs>
        <tab id="ArcGISClaude_Tab" caption="ProCowork" keytip="C">
          <group refID="ArcGISClaude_Group" />
        </tab>
      </tabs>

      <groups>
        <group id="ArcGISClaude_Group" caption="ProCowork" keytip="A" appearsOnAddInTab="false">
          <button refID="ArcGISClaude_ShowChat" size="large" />
        </group>
      </groups>

      <controls>
        <button id="ArcGISClaude_ShowChat"
                caption="Chat"
                className="ShowChatDockPane"
                loadOnClick="true"
                keytip="CH"
                smallImage="Images\Chat16.png"
                largeImage="Images\Chat32.png">
          <tooltip heading="ProCowork Chat">
            Open the ProCowork assistant panel. The live-project bridge runs automatically.<disabledText />
          </tooltip>
        </button>
      </controls>

      <dockPanes>
        <dockPane id="ArcGISClaude_ChatDockPane"
                  caption="ProCowork"
                  className="ChatDockPaneViewModel"
                  dock="group"
                  dockWith="esri_core_contentsDockPane">
          <content className="ChatDockPaneView" />
        </dockPane>
      </dockPanes>

    </insertModule>
  </modules>

  <propertySheets>
    <updateSheet refID="esri_core_optionsPropertySheet">
      <insertPage id="ArcGISClaude_AuthOptionsPage"
                  caption="ProCowork"
                  className="AuthOptionsViewModel"
                  group="Application">
        <content className="AuthOptionsPage" />
      </insertPage>
    </updateSheet>
  </propertySheets>

</ArcGIS>
